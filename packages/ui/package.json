{
  "name": "@app/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./src/components/*.tsx"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && storybook build",
    "test": "vitest run --passWithNoTests",
    "storybook": "storybook dev -p 6006",
    "test:visual": "playwright test -c playwright.config.ts",
    "test:visual:update": "playwright test -c playwright.config.ts --update-snapshots",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@app/ui-tokens": "workspace:*",
    "@base-ui/react": "^1.6.0",
    "@hugeicons/core-free-icons": "4.2.2",
    "@hugeicons/react": "1.1.9",
    "@shadcn/react": "0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "motion": "12.42.2",
    "react-resizable-panels": "4.12.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.0",
    "@storybook/addon-docs": "10.5.0",
    "@storybook/addon-vitest": "10.5.0",
    "@storybook/react-vite": "10.5.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.2.7",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "msw": "2.15.0",
    "msw-storybook-addon": "2.0.7",
    "playwright": "1.61.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
